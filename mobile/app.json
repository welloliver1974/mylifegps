{
  "expo": {
    "name": "My Life360",
    "slug": "my-life360-mobile",
    "owner": "welloliveiras-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#762eeb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellington.mylife360",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O My Life360 precisa de acesso à localização para compartilhar sua posição com o seu círculo familiar em tempo real.",
        "NSLocationWhenInUseUsageDescription": "O My Life360 precisa de sua localização para exibir sua posição no mapa."
      }
    },
    "android": {
      "package": "com.wellington.mylife360",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#762eeb"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "BATTERY_STATS",
        "WAKE_LOCK",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "HIGH_SAMPLING_RATE_SENSORS",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita o My Life360 acompanhar sua localização para sua segurança familiar 24/7.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#762eeb"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ac668138-026b-4045-8658-25b2609d1b86"
      }
    }
  }
}
