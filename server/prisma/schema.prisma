generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  avatarUrl    String?
  color        String     @default("#3B82F6") // Hex color for map avatar
  phone        String?
  email        String?    @unique
  passwordHash String?    // Nulo para membros rastreados que nunca acessam o painel
  role         String     @default("member") // "admin" | "member"
  devices                Device[]
  sessions               AuthSession[]
  pushSubscriptions      PushSubscription[]
  sosEvents              SosEvent[]         @relation("SosUser")
  resolvedSosEvents      SosEvent[]         @relation("SosResolver")
  sentDirectMessages     DirectMessage[]    @relation("SentDMs")
  receivedDirectMessages DirectMessage[]    @relation("ReceivedDMs")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

// Sessões de acesso ao painel (tokens revogáveis, com expiração)
model AuthSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Device {
  id               String           @id @default(uuid())
  name             String           // Ex: "Galaxy S23 Wellington"
  deviceIdentifier String           @unique // Unique ID / IMEI / Traccar deviceId
  apiKey           String           @unique @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations        LocationRecord[]
  placeEvents      PlaceEvent[]
  lastSeenAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model LocationRecord {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  altitude   Float?
  accuracy   Float?   // Precisão em metros
  speed      Float?   // Velocidade em km/h ou m/s
  heading    Float?   // Direção (0 a 360 graus)
  battery    Float?   // Nível da bateria (0 a 100%)
  isCharging Boolean  @default(false)
  recordedAt DateTime @default(now()) // Timestamp do GPS no aparelho
  createdAt  DateTime @default(now()) // Timestamp de chegada no servidor

  @@index([deviceId, recordedAt])
}

model Place {
  id           String       @id @default(uuid())
  name         String       // Ex: "Casa", "Trabalho", "Escola"
  latitude     Float
  longitude    Float
  radiusMeters Float        @default(100.0) // Raio da cerca em metros
  color        String       @default("#10B981")
  icon         String       @default("home")
  placeEvents  PlaceEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model PlaceEvent {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  eventType  String   // "ENTER" | "EXIT"
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
  @@index([placeId, recordedAt])
}

// Chat do Círculo Familiar (recurso do Life360 liberado sem limites)
model CircleMessage {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  userColor String   @default("#3B82F6")
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Cache persistente de Geocoding Reverso (evita chamadas repetidas ao Nominatim/OSM)
model GeocodingCache {
  id        String   @id @default(uuid())
  latKey    Float
  lonKey    Float
  address   String
  road      String?
  suburb    String?
  city      String?
  fullJson  String?
  createdAt DateTime @default(now())

  @@unique([latKey, lonKey])
  @@index([latKey, lonKey])
}

// Inscrições Web Push (VAPID) para notificações no celular mesmo com navegador fechado
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Histórico de Alertas de SOS / Emergência (Life360 Safety History)
model SosEvent {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("SosUser", fields: [userId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float?
  battery      Int?
  status       String    @default("ACTIVE") // "ACTIVE" | "RESOLVED" | "CANCELED"
  message      String?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("SosResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// Mensagens Diretas 1:1 entre membros do círculo familiar (Etapa 8.8)
model DirectMessage {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("SentDMs", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedDMs", fields: [receiverId], references: [id], onDelete: Cascade)
  text       String
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, read])
}

// Registro de acessos à API (auditoria e segurança - Etapa 8.9)
model AccessLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  method     String
  path       String
  statusCode Int
  ip         String?
  userAgent  String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([statusCode])
}

