DATABASE_URL="file:./dev.db"
PORT=3000
HOST="0.0.0.0"
# Obtenha sua chave gratuita em https://carto.com/basemaps/apikey
CARTO_API_KEY="sua_chave_carto_aqui"

# Chaves VAPID para Web Push (geradas via web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="chave_publica_aqui"
VAPID_PRIVATE_KEY="chave_privada_aqui"
VAPID_SUBJECT="mailto:seu-email@dominio.com"

# ===== Segurança da ingestão de GPS (Etapa 8.9) =====
# true  = cada aparelho precisa da própria chave (padrão, recomendado)
# false = libera a ingestão para qualquer origem (APENAS em migração/local)
TELEMETRY_REQUIRE_KEY="true"
# Opcional: chave mestra que aceita qualquer deviceIdentifier (útil p/ Traccar)
# TELEMETRY_MASTER_KEY=""

# ===== Backup automático do SQLite (Etapa 8.9) =====
BACKUP_ENABLED="true"
# BACKUP_DIR="/var/backups/mylife360"
BACKUP_INTERVAL_HOURS="24"
BACKUP_RETENTION_DAYS="14"

# ===== Log de acessos / auditoria (Etapa 8.9) =====
ACCESS_LOG_RETENTION_DAYS="30"
